# Notion API 설정
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_PAGE_ID=your_notion_page_id_here

# Ollama 서버 설정
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768              # LLM 컨텍스트 길이 (기본: 32768)
OLLAMA_KEEP_ALIVE=-1              # 모델 상주 설정 (기본: -1, 항상 유지)
OLLAMA_TIMEOUT=120                # API 타임아웃 초 (기본: 120)
OLLAMA_MAX_RETRIES=3              # 최대 재시도 횟수 (기본: 3)

# 임베딩 설정
EMBEDDING_CONCURRENCY=8           # 동시 임베딩 요청 수 (기본: 8)
EMBEDDING_MAX_RETRIES=3           # 임베딩 재시도 횟수 (기본: 3)

# 검색 설정
SEARCH_TOP_K=20                   # 초기 검색 결과 수 (기본: 20)
RERANK_TOP_N=5                    # 리랭킹 후 최종 결과 수 (기본: 5)

# 동기화 설정
SYNC_INTERVAL_MINUTES=60          # 자동 동기화 주기 분 (기본: 60)
SYNC_STATE_PATH=./sync_state.json # 동기화 상태 파일 경로 (기본: ./sync_state.json)
